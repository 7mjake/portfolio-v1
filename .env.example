# Local development uses the persistent staging Neon branch only.
APP_ENV=staging
DATABASE_URL=postgresql://USER:PASSWORD@STAGING-ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@STAGING-ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require
PAYLOAD_SECRET=replace-with-a-long-random-staging-secret
PREVIEW_SECRET=replace-with-a-different-random-staging-secret
# Required in Production for password-reset emails. Resend must have the sender domain verified.
# EMAIL_FROM=portfolio@your-domain.com
# RESEND_API_KEY=re_...
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
STAGING_NEON_HOST=STAGING-ENDPOINT.REGION.aws.neon.tech
PRODUCTION_NEON_HOST=PRODUCTION-ENDPOINT.REGION.aws.neon.tech
BLOB_PUBLIC_HOSTNAME=nonproduction-store.public.blob.vercel-storage.com
PRODUCTION_BLOB_HOSTNAME=production-store.public.blob.vercel-storage.com
# Local uploads use ./media by default. Opt in only for Blob-specific testing.
USE_VERCEL_BLOB=false
# BLOB_READ_WRITE_TOKEN=
